<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HybridCrypt"
            android:textColor="#E94560"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de claves y sesiones"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- ── Sección 1: Generar claves RSA ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. TU PAR DE CLAVES RSA"
            android:textColor="#E94560"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN (mínimo 4 dígitos)"
            android:inputType="numberPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:backgroundTint="#0F3460"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_generar_claves"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Generar claves RSA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F3460"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btn_mostrar_qr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Mostrar mi clave pública (QR)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F3460"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null"/>

        <!-- QR de clave propia -->
        <ImageView
            android:id="@+id/iv_qr_propio"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:contentDescription="QR de tu clave pública"/>

        <!-- ── Sección 2: Contactos ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. CLAVE PÚBLICA DE CONTACTO"
            android:textColor="#E94560"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_contacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del contacto"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:backgroundTint="#0F3460"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_escanear_qr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Escanear QR del contacto"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F3460"
            android:layout_marginBottom="24dp"
            android:stateListAnimator="@null"/>

        <!-- ── Sección 3: Estado ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. ESTADO"
            android:textColor="#E94560"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_estado_ajustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="#0F3460"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- ── Sección 4: Activar teclado ── -->
        <Button
            android:id="@+id/btn_activar_teclado"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Activar teclado en el sistema"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E94560"
            android:stateListAnimator="@null"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activa HybridCrypt Keyboard en Ajustes del sistema y luego selecciónalo como teclado activo."
            android:textColor="#666666"
            android:textSize="11sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>